# Lean / Lake build outputs and downloaded packages
.lake/
build/
lake-packages/
lake-manifest.json

# Local dependencies for the custom InfoView widget. The bundled JavaScript in
# widget/js is committed so Lean users do not need Node.js to build the project.
widget/node_modules/

# Lean artifacts that should normally live under .lake/
*.olean
*.ilean
*.trace

# Local editor settings. Shared VS Code recommendations may still be committed.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS metadata
.DS_Store
Thumbs.db

# Local secrets and machine-specific environment files
.env
.env.*
!.env.example


# Generated Lake dependency manifest
/lake-manifest.json
